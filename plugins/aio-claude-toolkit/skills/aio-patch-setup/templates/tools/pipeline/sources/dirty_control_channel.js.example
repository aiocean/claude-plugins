        try {
          globalThis.__dc_broadcast && globalThis.__dc_broadcast("dialog.closed", { dialog_id: prevDid });
        } catch (_) {}
      }
    }
  }

  // ========== One-time install (HTTP server) ==========
  if (globalThis.__dc_server) return;

  let __dc_safe = (o, d, seen) => {
    if (d > 6 || o == null) return o;
    if (typeof o === "function") return "[fn:" + (o.name || "anon") + "]";
    if (typeof o !== "object") return o;
    if (seen.has(o)) return "[circular]";
    seen.add(o);
    if (Array.isArray(o)) return o.slice(0, 30).map(x => __dc_safe(x, d + 1, seen));
    let r = {};
    for (let k of Object.keys(o).slice(0, 60)) {
      try { r[k] = __dc_safe(o[k], d + 1, seen); } catch (_) { r[k] = "[err]"; }
    }
    return r;
  };
  let __dc_jsx_meta = (j) => {
    if (j == null || typeof j !== "object") return null;
    let t = j.type;
    let n = t == null ? "null" : typeof t === "string" ? t : (t.displayName || t.name || "anon-fn");
    return { component: n, propKeys: j.props ? Object.keys(j.props) : [], propsSummary: __dc_safe(j.props, 0, new Set) };
  };
  let __dc_dump = (el) => {
    if (el == null) return null;
    return { wrapperKeys: Object.keys(el), isLocalJSXCommand: el.isLocalJSXCommand, showSpinner: el.showSpinner, shouldHidePromptInput: el.shouldHidePromptInput, dialog_id: globalThis.__dc_current_dialog_id, jsx: __dc_jsx_meta(el.jsx) };
  };

  try {
    globalThis.__dc_server = require("node:http").createServer(async (rq, rs) => {
      // ----- GET /v1/diag — broadcast diagnostics -----
      if (rq.method === "GET" && rq.url === "/v1/diag") {
        rs.writeHead(200, { "content-type": "application/json" });
        let subs = [];
        for (let s of globalThis.__dc_subscribers) subs.push({ tag: s.tag, closeOnTurnEnd: !!s.closeOnTurnEnd });
        rs.end(JSON.stringify({ diag: globalThis.__dc_diag, subscribers: subs, subCount: globalThis.__dc_subscribers.size }, null, 2));
        return;
      }

