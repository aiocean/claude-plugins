// dirty-claude control channel — INJECT@dirty_control_channel
//
// Source-of-truth (readable). Inlined into patches.json's "new" field by
// tools/pipeline/inline_sources.py before patch_cli.py runs.
//
// What changed vs prior version: real-time SSE streaming. Anthropic SSE
// chunks are forwarded per-chunk to subscribers (zero extra latency vs the
// upstream stream), turn boundaries detected from "stop_reason" field
// (no more DC_STABLE_MS heuristic for the streaming path), dialog
// transitions broadcast as events. Blocking JSON path on POST /v1/prompt
// preserved bit-for-bit for backward compat.
//
// Endpoints:
//   POST /v1/prompt
//     Accept: application/json (default) -> blocking, returns full JSON
//     Accept: text/event-stream          -> SSE, per-chunk events, closes on turn.end
//   GET  /v1/stream                      -> ambient SSE subscriber, never closes
//   GET  /v1/state                       -> unchanged
//   POST /v1/answer                      -> unchanged
//
// Event schema (sent to all SSE subscribers):
//   event: turn.start        data: {turn_uuid, prompt}        (POST SSE only, one-shot)
//   event: anthropic.chunk   data: {url, chunk}               (every Anthropic SSE chunk)
//   event: dialog.opened     data: {dialog_id, component, propKeys}
//   event: dialog.closed     data: {dialog_id}
//   event: turn.end          data: {stop_reason, source, url?} (terminal stop_reason or idle fallback)
//   :ping                                                     (keep-alive every 15s)
//
// Design notes — see docs/control-channel.md for full doc.
//   1. lastStopReason is PER-FETCH-CALL (declared inside IIFE), not global,
//      so concurrent Anthropic calls don't clobber each other.
//   2. stop_reason regex runs on accumulated TX (with -30 byte overlap on
//      the new region), so chunk-boundary splits don't miss the field.
//   3. No subscriber filtering in phase 1. SSE subscribers receive ALL
//      broadcast events including ambient terminal-user activity. Caveat
//      documented; promote to filter-by-turn_uuid if real pain emerges.
//   4. broadcast() and subscriber Set live on globalThis; fetch wrap and
//      dialog detection read them via globalThis lazily so React re-renders
//      don't capture stale references.

f6.useEffect(() => {
  // ========== One-time install (fetch wrap + broadcast + subscriber Set) ==========
  if (!globalThis.__dc_fetch_wrapped) {
    globalThis.__dc_fetch_wrapped = true;
    globalThis.__dc_http_log = [];
    globalThis.__dc_subscribers = globalThis.__dc_subscribers || new Set();
    globalThis.__dc_TURN_END_REASONS = new Set(["end_turn", "max_tokens", "stop_sequence", "refusal"]);
    globalThis.__dc_diag = { broadcasts: 0, writes: 0, writeErrs: 0, lastErr: null, history: [] };

    // Broadcast helper. Re-assignment OK across re-renders; consumers read via globalThis lazily.
    // Subscribers carry `closeOnTurnEnd` flag: POST /v1/prompt SSE wants close, /v1/stream doesn't.
    globalThis.__dc_broadcast = function (name, data) {
      let D = globalThis.__dc_diag;
      D.broadcasts++;
      let perSubResults = [];
      let msg = "event: " + name + "\ndata: " + JSON.stringify(data) + "\n\n";
      let i = 0;
      for (let s of globalThis.__dc_subscribers) {
        let tag = s.tag || "?";
        try {
          let r = s.write(msg);
          D.writes++;
          perSubResults.push({ i, tag, ok: true, ret: r });
        } catch (E) {
          D.writeErrs++;
          D.lastErr = String(E);
          perSubResults.push({ i, tag, ok: false, err: String(E) });
        }
        if (s.closeOnTurnEnd && name === "turn.end") {
          setTimeout(() => {
            globalThis.__dc_subscribers.delete(s);
            try { s.end(); } catch (_) {}
          }, 10);
        }
        i++;
      }
      D.history.push({ ts: Date.now(), event: name, subs: perSubResults });
      if (D.history.length > 50) D.history.shift();
    };

    let __dc_of = globalThis.fetch;
    globalThis.fetch = async function (I, N) {
      let U = typeof I === "string" ? I : (I && I.url) || "";
      // Fire request_start BEFORE awaiting upstream — gives subscribers a
      // signal that an Anthropic call is in flight before any byte returns.
      // Critical for the SSE POST handler's slash-command-vs-API discriminator.
      if (U.includes("api.anthropic.com")) {
        try { globalThis.__dc_broadcast && globalThis.__dc_broadcast("anthropic.request_start", { url: U }); } catch (_) {}
      }
      let R = await __dc_of.call(this, I, N);
      try {
        if (!U.includes("api.anthropic.com")) return R;
        if (!R.body) return R;
        let [A, B] = R.body.tee();
        let M = new Response(A, { status: R.status, statusText: R.statusText, headers: R.headers });
        (async () => {
          let RD = B.getReader();
          let DC = new TextDecoder();
          let TX = "";
          let lastStopReason = null;     // PER-CALL scope (advisor risk #1)
          let lastScannedLen = 0;
          try {
            while (true) {
              let { done: D, value: V } = await RD.read();
              if (D) break;
              let chunkText = DC.decode(V, { stream: true });
              TX += chunkText;
              // Per-chunk broadcast (raw passthrough — client parses SSE).
              try {
                globalThis.__dc_broadcast && globalThis.__dc_broadcast("anthropic.chunk", { url: U, chunk: chunkText });
              } catch (_) {}
