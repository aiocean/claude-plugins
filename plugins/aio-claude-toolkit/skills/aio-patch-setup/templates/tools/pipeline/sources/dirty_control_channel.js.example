      let t = l6.jsx.type;
      let cn = t == null ? "null" : typeof t === "string" ? t : (t.displayName || t.name || "anon-fn");
      let cbs = {};
      for (let k of Object.keys(l6.jsx.props)) {
        if (typeof l6.jsx.props[k] === "function") cbs[k] = l6.jsx.props[k];
      }
      globalThis.__dc_dialog_cache.set(did, { id: did, component: cn, callbacks: cbs, createdAt: Date.now() });
      globalThis.__dc_current_dialog_id = did;
      if (globalThis.__dc_dialog_cache.size > 10) {
        let first = globalThis.__dc_dialog_cache.keys().next().value;
        globalThis.__dc_dialog_cache.delete(first);
      }
      try {
        globalThis.__dc_broadcast && globalThis.__dc_broadcast("dialog.opened", { dialog_id: did, component: cn, propKeys: Object.keys(l6.jsx.props) });
      } catch (_) {}
