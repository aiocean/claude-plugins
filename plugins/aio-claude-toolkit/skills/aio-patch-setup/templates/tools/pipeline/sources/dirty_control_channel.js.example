            let result;
            try { result = fn.apply(null, ag); }
            catch (e) {
              rs.writeHead(500, { "content-type": "application/json" });
              rs.end(JSON.stringify({ error: "callback threw", detail: String(e && e.stack || e), dialog_id: snap.id }));
              return;
