              }
              lastScannedLen = TX.length;
            }
            TX += DC.decode();
          } catch (E) {
            TX += "\n[dc-stream-error: " + String(E) + "]";
          }
          let H = {};
          for (let [K, V] of R.headers.entries()) H[K] = V;
          globalThis.__dc_http_log.push({ ts: Date.now(), url: U, status: R.status, headers: H, body: TX });
          if (globalThis.__dc_http_log.length > 200) globalThis.__dc_http_log.shift();
          // Decide turn.end. Terminal stop_reason -> broadcast. tool_use/pause_turn -> stay open (next call coming).
          if (lastStopReason && globalThis.__dc_TURN_END_REASONS.has(lastStopReason)) {
