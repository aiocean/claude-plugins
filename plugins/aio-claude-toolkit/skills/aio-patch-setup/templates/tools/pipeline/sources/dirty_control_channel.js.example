  // ========== Per-render: capture latest globals + dialog transition detection ==========
  globalThis.__dc_submit = kCH;
  globalThis.__dc_msgs = () => new Promise(r => R4(p => { r(p); return p; }));
  globalThis.__dc_toolJSX = l6;
  globalThis.__dc_setToolJSX = j6;
  globalThis.__dc_appstate = () => { try { return AH.getState(); } catch (_) { return null; } };
  globalThis.__dc_dialog_cache = globalThis.__dc_dialog_cache || new Map();

  if (globalThis.__dc_last_l6 !== l6) {
